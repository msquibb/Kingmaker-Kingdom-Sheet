@page "/"

<PageTitle>Home - Kingmaker Kingdom Sheet</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 mb-4">Welcome to Kingmaker Kingdom Sheet</h1>
            <p class="lead mb-4">
                Manage your Pathfinder Kingmaker campaigns with ease. Track kingdoms, settlements, 
                and all the details that make your realm thrive.
            </p>
            
            <div class="d-flex gap-3 justify-content-center mb-5">
                <a href="/kingdoms" class="btn btn-primary btn-lg">
                    <span class="bi bi-map-fill"></span> View Kingdoms
                </a>
                <a href="/auth/login" class="btn btn-outline-secondary btn-lg">
                    <span class="bi bi-box-arrow-in-right"></span> Login
                </a>
            </div>

            <div class="card mt-4">
                <div class="card-body">
                    <h5 class="card-title">New to Kingmaker Kingdom Sheet?</h5>
                    <p class="card-text">
                        Create an account to start managing your kingdoms, track your settlements, 
                        and collaborate with your fellow rulers.
                    </p>
                    <a href="/auth/register" class="btn btn-success">
                        <span class="bi bi-person-plus-fill"></span> Create Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
