@page "/kingdoms"
@inject KingdomApiClient ApiClient
@attribute [StreamRendering]

<PageTitle>Kingdoms - Kingmaker Kingdom Sheet</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Kingdoms</h1>
        <button class="btn btn-success" disabled>
            <span class="bi bi-plus-circle-fill"></span> Create Kingdom
        </button>
    </div>

    @if (kingdoms == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3">Loading kingdoms...</p>
        </div>
    }
    else if (!kingdoms.Any())
    {
        <div class="alert alert-info">
            <h4 class="alert-heading">No kingdoms found</h4>
            <p>You don't have any kingdoms yet. Create your first kingdom to get started!</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var kingdom in kingdoms)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@kingdom.Name</h5>
                            <p class="card-text text-muted mb-3">
                                <small>Level @kingdom.Level • Size @kingdom.Size</small>
                            </p>
                            <ul class="list-unstyled">
                                <li><strong>Hexes:</strong> @kingdom.ClaimedHexCount</li>
                                <li><strong>Settlements:</strong> @kingdom.TownCount</li>
                                <li><strong>Members:</strong> @kingdom.MemberCount</li>
                            </ul>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a href="/kingdoms/@kingdom.Id" class="btn btn-primary btn-sm w-100">
                                <span class="bi bi-eye-fill"></span> View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<KingdomSummaryDto>? kingdoms;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            kingdoms = await ApiClient.GetKingdomsAsync();
        }
        catch (Exception)
        {
            kingdoms = [];
        }
    }
}
